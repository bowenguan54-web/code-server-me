at] = []\n    for i in range(len(data)):\n        if i < window - 1:\n            result.append(float(\"nan\"))\n        else:\n            window_data = data[i - window + 1 : i + 1]\n            result.append(sum(window_data) / window)\n    return result","type":"component","moduleKind":"component","lifecycleStatus":"draft","publishStatus":"draft","hasReviewDraft":false,"reviewStatus":"","apiPath":"/api/v1/invoke/alg.statistics.moving_average.moving_average","externalApiPath":"/api/external/v1/statistics.moving_average/moving_average","displayNamespace":"alg.statistics.moving_average.moving_average","zhName":"moving_average","zhDescription":"è®¡ç®ç®åç§»å¨å¹³åã","zhTags":[],"inputExample":"","widgetOverrides":{},"enDescription":"è®¡ç®ç®åç§»å¨å¹³åã","params":[{"name":"data","type":"List[float]","default":null,"description":"è¾å¥æ¶é´åºåæ°æ®ã","widget_hint":"list"},{"name":"window","type":"int","default":"3","description":"æ»å¨çªå£å¤§å°ï¼é»è®¤ä¸º 3ã","widget_hint":"int"}],"namespace":"statistics.moving_average","categoryZhName":"ç§»å¨å¹³å","categoryNamespace":"statistics.moving_average","version":"1.0.0","funcName":"moving_average","packageId":null,"packageRoot":null,"sourceFile":"E:\\code-server-me\\algorithms_root\\users\\usr_zhangsan\\statistics\\moving_average\\moving_average.py","ownerId":"usr_zhangsan","contributors":[],"privateChangeLogs":[],"publicChangeLogs":[],"pendingPublicChangeLogs":[],"rejectReason":"","reviewKind":"","targetPublicId":"","targetPublicCallPrefix":""},{"id":"timeseries.zscore_anomaly.zscore_anomaly@@usr_zhangsan","registryId":"timeseries.zscore_anomaly.zscore_anomaly","callPrefix":"alg.timeseries.zscore_anomaly.zscore_anomaly","callSnippet":"alg.timeseries.zscore_anomaly.zscore_anomaly(${1:data}, ${2:threshold})","snippetBody":"def zscore_anomaly(data: List[float], threshold: float = 3.0) -> Dict[str, Any]:\n    \"\"\"åºäº Z-Score çæ¶é´åºåå¼å¸¸æ£æµã\n\n    Args:\n        data: è¾å¥æ¶é´åºåæ°æ®ã\n        threshold: å¤å®ä¸ºå¼å¸¸ç Z-Score éå¼ï¼é»è®¤ 3.0ï¼å³ 3 åæ åå·®ï¼ã\n\n    Returns:\n        åå«ä»¥ä¸å­æ®µçå­å¸ï¼\n            - z_scores: æ¯ä¸ªç¹ç Z-Score åè¡¨\n            - anomaly_flags: æ¯ä¸ªç¹æ¯å¦ä¸ºå¼å¸¸çå¸å°åè¡¨\n            - anomaly_indices: å¼å¸¸ç¹çç´¢å¼åè¡¨\n    \"\"\"\n    if not data:\n        return {\"z_scores\": [], \"anomaly_flags\": [], \"anomaly_indices\": []}\n\n    n = len(data)\n    mean = sum(data) / n\n    variance = sum((x - mean) ** 2 for x in data) / n\n    std = math.sqrt(variance) if variance > 0 else 1e-10\n\n    z_scores = [(x - mean) / std for x in data]\n    anomaly_flags = [abs(z) > threshold for z in z_scores]\n    anomaly_indices = [i for i, flag in enumerate(anomaly_flags) if flag]\n\n    return {\n        \"z_scores\": [round(z, 4) for z in z_scores],\n        \"anomaly_flags\": anomaly_flags,\n        \"anomaly_indices\": anomaly_indices,\n    }","type":"component","moduleKind":"component","lifecycleStatus":"draft","publishStatus":"draft","hasReviewDraft":false,"reviewStatus":"","apiPath":"/api/v1/invoke/alg.timeseries.zscore_anomaly.zscore_anomaly","externalApiPath":"/api/external/v1/timeseries.zscore_anomaly/zscore_anomaly","displayNamespace":"alg.timeseries.zscore_anomaly.zscore_anomaly","zhName":"zscore_anomaly","zhDescription":"åºäº Z-Score çæ¶é´åºåå¼å¸¸æ£æµã","zhTags":[],"inputExample":"","widgetOverrides":{},"enDescription":"åºäº Z-Score çæ¶é´åºåå¼å¸¸æ£æµã","params":[{"name":"data","type":"List[float]","default":null,"description":"è¾å¥æ¶é´åºåæ°æ®ã","widget_hint":"list"},{"name":"threshold","type":"float","default":"3.0","description":"å¤å®ä¸ºå¼å¸¸ç Z-Score éå¼ï¼é»è®¤ 3.0ï¼å³ 3 åæ åå·®ï¼ã","widget_hint":"float"}],"namespace":"timeseries.zscore_anomaly","categoryZhName":"Z-Score å¼å¸¸æ£æµ","categoryNamespace":"timeseries.zscore_anomaly","version":"1.0.0","funcName":"zscore_anomaly",